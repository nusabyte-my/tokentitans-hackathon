# GuardianBox Edge Configuration
# Target: Gigabyte AI TOP ATOM (NVIDIA DGX Spark)

# Nemotron Local Model Endpoints (Ollama, vLLM, or NVIDIA NeMo)
NEMOTRON_OMNI_ENDPOINT=http://127.0.0.1:8000/v1
NEMOTRON_LIGHTNING_ENDPOINT=http://127.0.0.1:8000/v1
NEMOTRON_NANO_ENDPOINT=http://127.0.0.1:8000/v1
NEMOTRON_API_KEY=nemotron-local-token

# Telegram Bot Automation (Optional: leave empty to run in simulated interactive mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Edge Pipeline Tunables
FLOOR_DEBOUNCE_SECONDS=2.5
ASPECT_RATIO_THRESHOLD=1.25
CAMERA_DEVICE_INDEX=0
PORT=53532
